# ---------------------------------------------------------------------------
# Herald runs with NO keys at all: `pnpm car` uses simulated workers and a
# scripted Chief. Add keys only when you want real agents or a real LLM.
# ---------------------------------------------------------------------------

# --- Chief LLM (optional) --------------------------------------------------
# Option A (recommended, free tier): Google Gemini via its OpenAI-compatible
# endpoint. Get a key at https://aistudio.google.com/apikey
# OPENAI_API_KEY=your_gemini_key
# HERALD_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# HERALD_LLM_MODEL=gemini-2.0-flash

# Option B: OpenAI (paid)
# OPENAI_API_KEY=sk-...
# HERALD_LLM_BASE_URL=https://api.openai.com/v1
# HERALD_LLM_MODEL=gpt-4.1

# Option C: anything OpenAI-compatible you run locally (Ollama, LM Studio)
# OPENAI_API_KEY=ollama
# HERALD_LLM_BASE_URL=http://127.0.0.1:11434/v1
# HERALD_LLM_MODEL=llama3.1

# --- Cursor Cloud Agents (optional; costs money per agent) -----------------
# Dashboard → API Keys. Server only; never sent to the car client.
CURSOR_API_KEY=

# GitHub repo the key may launch agents against (https://github.com/org/repo)
HERALD_TEST_REPO=
HERALD_REPO_ALLOWLIST=
HERALD_STARTING_REF=main

# --- GitHub MCP (optional, read-only) --------------------------------------
# Fine-grained PAT limited to the demo repo: Contents, Pull requests, Issues,
# Actions = Read-only. Server only; never sent to the car client.
GITHUB_MCP_TOKEN=
# GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/readonly
# HERALD_GITHUB_POLL_MS=45000
# The repo comes from HERALD_TEST_REPO / HERALD_REPO_ALLOWLIST above.

# --- Caps -----------------------------------------------------------------
HERALD_MAX_CONCURRENT=3
HERALD_LAUNCH_CAP=5
HERALD_CONFIRM_TIMEOUT_MS=25000
